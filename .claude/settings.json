{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter analyze *)",
      "Bash(flutter analyze)",
      "Bash(flutter test *)",
      "Bash(flutter test)",
      "Bash(flutter build *)",
      "Bash(dart format *)",
      "Bash(supabase start *)",
      "Bash(supabase start)",
      "Bash(supabase stop *)",
      "Bash(supabase status *)",
      "Bash(supabase db reset)",
      "Bash(supabase db lint *)",
      "Bash(supabase test db *)",
      "Bash(supabase test db)",
      "Bash(supabase migration new *)",
      "Bash(npm ci *)",
      "Bash(npx playwright test *)",
      "Bash(bash scripts/ci/guard.sh *)",
      "Bash(bash scripts/ci/risk.sh *)",
      "Bash(bash scripts/dev/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)"
