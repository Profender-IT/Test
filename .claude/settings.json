      "Read(./local/raw/**)",
      "Read(./**/*.xlsx)",
      "Read(./**/*.dump)",
      "Bash(supabase link*)",
      "Bash(npx supabase link*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(supabase functions deploy*)",
      "Bash(npx supabase functions deploy*)",
      "Bash(supabase secrets*)",
      "Bash(npx supabase secrets*)",
      "Bash(supabase login*)",
      "Bash(supabase projects*)",
      "Bash(supabase branches*)",
      "Bash(supabase * --linked*)",
      "Bash(supabase * --remote*)",
      "Bash(supabase * --db-url*)",
      "Bash(supabase * --project-ref*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ]
  }
}
