# ตัวอย่างค่าของ docker-compose.yml · สร้างค่าจริงด้วย: bash scripts/dev/compose_env.sh
PUBLIC_URL=http://localhost:8000
POSTGRES_PASSWORD=<สุ่ม>
JWT_SECRET=<สุ่ม อย่างน้อย 32 ตัวอักษร>
JWT_EXP=3600
ANON_KEY=<JWT role=anon เซ็นด้วย JWT_SECRET>
SERVICE_ROLE_KEY=<JWT role=service_role เซ็นด้วย JWT_SECRET · Studio เท่านั้น>
