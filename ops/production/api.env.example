# ค่าตัวอย่าง (ไม่มีค่าจริง) · on-prem และ cloud ใช้ตัวแปรชุดเดียวกัน
NODE_ENV=production
BASE_PATH=/roombooking
DATABASE_URL=postgres://roombooking_api:<รหัส>@<db-host>:5432/roombooking
PGSSLMODE=require                 # on-prem ใน LAN อาจเป็น disable · cloud ต้อง require/verify-full
REDIS_URL=redis://<host>:6379
STORAGE_ENDPOINT=https://<minio-or-s3-endpoint>     # S3: https://s3.ap-southeast-7.amazonaws.com
STORAGE_REGION=ap-southeast-7
STORAGE_BUCKET=roombooking-files
STORAGE_ACCESS_KEY_ID=<จาก secret manager>
STORAGE_SECRET_ACCESS_KEY=<จาก secret manager>
OIDC_ISSUER=https://<keycloak-or-entra>/realms/<realm>
OIDC_CLIENT_ID=roombooking-web
TRUST_PROXY=true
LOG_LEVEL=info
